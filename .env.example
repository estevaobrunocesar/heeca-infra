# Token da Cloudflare com permissão "Zone.DNS: Edit" (e "Zone: Read") na zona heeca.com.br.
# Copie este arquivo para .env e preencha. O .env é ignorado pelo git e nunca é lido pelo Claude.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE=heeca.com.br
# IP público do servidor (Coolify). Preencha quando confirmar o servidor.
SERVER_IP=5.161.233.128
# Coolify (API em https://<host>:8000 ou domínio do painel). Token em Keys & Tokens → API tokens.
COOLIFY_URL=
COOLIFY_TOKEN=
